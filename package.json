{
  "name": "@commentary-dev/commentary-skills",
  "version": "0.6.2",
  "description": "Marketplace and canonical source for Commentary agent skills.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "examples:agent-inbox": "node --test examples/agent-inbox/test/*.test.mjs",
    "generate": "node scripts/generate-catalog.mjs && node scripts/generate-claude-plugins.mjs",
    "validate": "node scripts/validate-skills.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "public:check": "node scripts/public-readiness-check.mjs",
    "format:check": "node scripts/check-format.mjs",
    "evals:check": "node scripts/check-forward-evals.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "verify": "npm run generate && npm run validate && npm run check:generated && npm run public:check && npm run evals:check && npm run examples:agent-inbox && npm run format:check && npm run release:build && npm run release:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commentary-dev/commentary-skills.git"
  }
}
